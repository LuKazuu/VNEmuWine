+static BOOL vmr7_presenter_use_gdi_fallback(void)
+{
+    const char *value = getenv("WINE_VMR7_GDI_FALLBACK");
+
+    return value && value[0] && value[0] != '0';
+}
+
+static HRESULT vmr7_presenter_present_rgb_gdi(struct vmr7_presenter *presenter, IDirectDrawSurface7 *surface)
+{
+    DDSURFACEDESC2 surface_desc = {.dwSize = sizeof(surface_desc)};
+    struct
+    {
+        BITMAPINFOHEADER header;
+        DWORD masks[3];
+    } bmi = {0};
+    unsigned int width, height, bpp, row_size, copy_size, pitch, i;
+    BYTE *bits, *packed = NULL;
+    HRESULT hr = S_OK;
+    RECT rect;
+    HDC dc;
+    int ret;
+
+    if (FAILED(hr = IDirectDrawSurface7_Lock(surface, NULL, &surface_desc, DDLOCK_READONLY | DDLOCK_WAIT, NULL)))
+    {
+        WARN("Failed to lock VMR7 RGB surface for GDI presentation, hr %#lx.\n", hr);
+        return hr;
+    }
+
+    if (!(surface_desc.ddpfPixelFormat.dwFlags & DDPF_RGB))
+    {
+        WARN("GDI fallback only supports RGB surfaces, flags %#lx.\n",
+                surface_desc.ddpfPixelFormat.dwFlags);
+        hr = DDERR_INVALIDPIXELFORMAT;
+        goto done;
+    }
+
+    if (surface_desc.lPitch < 0)
+    {
+        WARN("GDI fallback does not support negative pitch %ld.\n", surface_desc.lPitch);
+        hr = E_NOTIMPL;
+        goto done;
+    }
+
+    width = surface_desc.dwWidth;
+    height = surface_desc.dwHeight;
+    bpp = surface_desc.ddpfPixelFormat.dwRGBBitCount;
+    pitch = surface_desc.lPitch;
+    row_size = ((width * bpp + 31) / 32) * 4;
+    copy_size = min(row_size, pitch);
+    bits = surface_desc.lpSurface;
+
+    if (bpp != 16 && bpp != 24 && bpp != 32)
+    {
+        WARN("GDI fallback does not support %u bpp surfaces.\n", bpp);
+        hr = E_NOTIMPL;
+        goto done;
+    }
+
+    if (pitch != row_size)
+    {
+        if (!(packed = malloc(row_size * height)))
+        {
+            hr = E_OUTOFMEMORY;
+            goto done;
+        }
+
+        for (i = 0; i < height; ++i)
+            memcpy(packed + i * row_size, bits + i * pitch, copy_size);
+        bits = packed;
+    }
+
+    bmi.header.biSize = sizeof(bmi.header);
+    bmi.header.biWidth = width;
+    bmi.header.biHeight = -(LONG)height;
+    bmi.header.biPlanes = 1;
+    bmi.header.biBitCount = bpp;
+    bmi.header.biSizeImage = row_size * height;
+
+    if (surface_desc.ddpfPixelFormat.dwRBitMask || surface_desc.ddpfPixelFormat.dwGBitMask
+            || surface_desc.ddpfPixelFormat.dwBBitMask)
+    {
+        bmi.header.biCompression = BI_BITFIELDS;
+        bmi.masks[0] = surface_desc.ddpfPixelFormat.dwRBitMask;
+        bmi.masks[1] = surface_desc.ddpfPixelFormat.dwGBitMask;
+        bmi.masks[2] = surface_desc.ddpfPixelFormat.dwBBitMask;
+    }
+    else
+    {
+        bmi.header.biCompression = BI_RGB;
+    }
+
+    GetClientRect(presenter->window, &rect);
+    dc = GetDC(presenter->window);
+    ret = StretchDIBits(dc, 0, 0, rect.right - rect.left, rect.bottom - rect.top,
+            0, 0, width, height, bits, (BITMAPINFO *)&bmi, DIB_RGB_COLORS, SRCCOPY);
+    ReleaseDC(presenter->window, dc);
+
+    if (ret == GDI_ERROR)
+    {
+        WARN("StretchDIBits failed in VMR7 GDI fallback.\n");
+        hr = E_FAIL;
+    }
+
+done:
+    free(packed);
+    IDirectDrawSurface7_Unlock(surface, NULL);
+    return hr;
+}
