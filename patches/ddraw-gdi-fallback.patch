+/* When WINE_DDRAW_GDI_FALLBACK is set, ddraw_surface_update_frontbuffer()
+ * skips the wined3d blit path (which blits to WINED3D_LOCATION_DRAWABLE via
+ * glBlitFramebuffer) and always uses the GDI BitBlt fallback instead. This
+ * is needed on stacks where blitting to the default framebuffer is
+ * unreliable, e.g. zink over a Turnip wrapper without DRI3 on Termux-X11. */
+static BOOL ddraw_use_gdi_fallback(void)
+{
+    const char *value = getenv("WINE_DDRAW_GDI_FALLBACK");
+    return value && value[0] && value[0] != '0';
+}
