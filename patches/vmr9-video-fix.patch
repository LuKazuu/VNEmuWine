+    {
+        DWORD max_sample_size = 16384;
+        /* Each IMediaSample must contain a complete compressed frame for the
+         * downstream decoder to accept it. For WMA Pro the frame size is
+         * nBlockAlign (e.g. 20434 bytes for 440 kbps 44.1 kHz stereo).
+         * The default cap of 16384 is too small for high-bitrate WMA Pro,
+         * causing frames to be split across IMediaSamples which the decoder
+         * rejects with "Input packet too small".
+         *
+         * This applies regardless of read_compressed because even when the
+         * IWMReader is configured for uncompressed output, it may still
+         * deliver compressed frames when it cannot decode the format
+         * internally (relying on an external DMO decoder instead). */
+        if (stream->format.u.audio.block_align > max_sample_size)
+            max_sample_size = stream->format.u.audio.block_align;
