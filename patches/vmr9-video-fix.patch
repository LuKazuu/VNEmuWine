diff --git a/dlls/quartz/vmr9.c b/dlls/quartz/vmr9.c
index 611a125..332f57d 100644
--- a/dlls/quartz/vmr9.c
+++ b/dlls/quartz/vmr9.c
@@ -1518,12 +1518,24 @@ static HRESULT WINAPI VMR9SurfaceAllocatorNotify_AllocateSurfaceHelper(IVMRSurfa
             allocinfo->dwFlags, allocinfo->dwWidth, allocinfo->dwHeight,
             allocinfo->Format, allocinfo->Format, allocinfo->Pool, allocinfo->MinBuffers);
 
-    if ((allocinfo->dwFlags & VMR9AllocFlag_TextureSurface)
-            && (allocinfo->dwFlags & VMR9AllocFlag_OffscreenSurface))
-    {
-        WARN("Invalid flags specified; returning E_INVALIDARG.\n");
-        return E_INVALIDARG;
-    }
+    /* VMR9AllocFlag_3DRenderTarget, VMR9AllocFlag_TextureSurface and
+     * VMR9AllocFlag_OffscreenSurface are documented as mutually exclusive
+     * in the VMR9 SDK. The previous implementation rejected the
+     * TextureSurface | OffscreenSurface combination with E_INVALIDARG.
+     *
+     * However, real-world applications - notably the custom VMR9
+     * allocator/presenters used by Visual Novel engines such as KiriKiri -
+     * routinely pass VMR9AllocFlag_TextureSurface together with
+     * VMR9AllocFlag_OffscreenSurface when allocating YUV video surfaces.
+     * Rejecting the combination forced the application to fall back to a
+     * plain offscreen surface, which cannot be sampled by a pixel shader,
+     * breaking shader-based YUV-to-RGB colour conversion.
+     *
+     * The combination is now honoured by allocating a texture surface (its
+     * top-level surface can be retrieved via GetSurfaceLevel and used as
+     * either a texture or an offscreen plain surface). The branches below
+     * use bitwise tests instead of equality so additional bits in dwFlags
+     * no longer cause the request to fall through to E_NOTIMPL. */
 
     if (!allocinfo->Format)
     {
@@ -1550,17 +1562,20 @@ static HRESULT WINAPI VMR9SurfaceAllocatorNotify_AllocateSurfaceHelper(IVMRSurfa
         return VFW_E_WRONG_STATE;
     }
 
-    if (allocinfo->dwFlags == VMR9AllocFlag_OffscreenSurface)
+    /* Allocation priority: 3DRenderTarget > TextureSurface > OffscreenSurface.
+     * A combined TextureSurface | OffscreenSurface request is satisfied as a
+     * texture, which is the more capable surface type. */
+    if (allocinfo->dwFlags & VMR9AllocFlag_3DRenderTarget)
     {
         for (i = 0; i < *numbuffers; ++i)
         {
-            hr = IDirect3DDevice9_CreateOffscreenPlainSurface(This->allocator_d3d9_dev,  allocinfo->dwWidth, allocinfo->dwHeight,
-                                                             allocinfo->Format, allocinfo->Pool, &surface[i], NULL);
-            if (FAILED(hr))
+            if (FAILED(hr = IDirect3DDevice9_CreateRenderTarget(This->allocator_d3d9_dev,
+                    allocinfo->dwWidth, allocinfo->dwHeight, allocinfo->Format,
+                    D3DMULTISAMPLE_NONE, 0, FALSE, &surface[i], NULL)))
                 break;
         }
     }
-    else if (allocinfo->dwFlags == VMR9AllocFlag_TextureSurface)
+    else if (allocinfo->dwFlags & VMR9AllocFlag_TextureSurface)
     {
         for (i = 0; i < *numbuffers; ++i)
         {
@@ -1574,20 +1589,21 @@ static HRESULT WINAPI VMR9SurfaceAllocatorNotify_AllocateSurfaceHelper(IVMRSurfa
             IDirect3DTexture9_Release(texture);
         }
     }
-    else if (allocinfo->dwFlags == VMR9AllocFlag_3DRenderTarget)
+    else if (allocinfo->dwFlags & VMR9AllocFlag_OffscreenSurface)
     {
         for (i = 0; i < *numbuffers; ++i)
         {
-            if (FAILED(hr = IDirect3DDevice9_CreateRenderTarget(This->allocator_d3d9_dev,
-                    allocinfo->dwWidth, allocinfo->dwHeight, allocinfo->Format,
-                    D3DMULTISAMPLE_NONE, 0, FALSE, &surface[i], NULL)))
+            hr = IDirect3DDevice9_CreateOffscreenPlainSurface(This->allocator_d3d9_dev,  allocinfo->dwWidth, allocinfo->dwHeight,
+                                                             allocinfo->Format, allocinfo->Pool, &surface[i], NULL);
+            if (FAILED(hr))
                 break;
         }
     }
     else
     {
-        FIXME("Unhandled flags %#lx.\n", allocinfo->dwFlags);
-        return E_NOTIMPL;
+        WARN("No surface allocation flag specified in dwFlags %#lx; returning E_INVALIDARG.\n",
+                allocinfo->dwFlags);
+        return E_INVALIDARG;
     }
 
     if (FAILED(hr))
diff --git a/dlls/winegstreamer/quartz_parser.c b/dlls/winegstreamer/quartz_parser.c
index 38971f2..f49e96c 100644
--- a/dlls/winegstreamer/quartz_parser.c
+++ b/dlls/winegstreamer/quartz_parser.c
@@ -1361,7 +1361,18 @@ static void send_buffer(struct parser_source *pin, struct parser *filter, const
         pin->need_segment = false;
     }
 
-    if (IsEqualGUID(&pin->pin.pin.mt.formattype, &FORMAT_WaveFormatEx)
+    /* When output_compressed is true the GStreamer pipeline delivers complete
+     * compressed frames (one media object per GstBuffer). Each frame must be
+     * delivered to the downstream DMO in a single IMediaSample; splitting it
+     * (as the PCM path below does) causes the decoder to reject the fragments
+     * with "Input packet too small".
+     *
+     * The PCM path is also incorrectly taken when the pin's media type still
+     * says PCM from a previous probe (output_compressed=0) even though the
+     * current pipeline outputs compressed data. Guard against that by checking
+     * output_compressed here. */
+    if (!filter->output_compressed
+            && IsEqualGUID(&pin->pin.pin.mt.formattype, &FORMAT_WaveFormatEx)
             && (IsEqualGUID(&pin->pin.pin.mt.subtype, &MEDIASUBTYPE_PCM)
             || IsEqualGUID(&pin->pin.pin.mt.subtype, &MEDIASUBTYPE_IEEE_FLOAT)))
     {
@@ -2290,6 +2301,7 @@ static HRESULT WINAPI GSTOutPin_DecideBufferSize(struct strmbase_source *iface,
         IMemAllocator *allocator, ALLOCATOR_PROPERTIES *props)
 {
     struct parser_source *pin = impl_source_from_IPin(&iface->pin.IPin_iface);
+    struct parser *filter = impl_from_strmbase_filter(pin->pin.pin.filter);
     unsigned int buffer_count = 1;
     unsigned int buffer_size = 16384;
     ALLOCATOR_PROPERTIES ret_props;
@@ -2320,6 +2332,23 @@ static HRESULT WINAPI GSTOutPin_DecideBufferSize(struct strmbase_source *iface,
         buffer_count = 3;
     }
 
+    /* When output_compressed is true each IMediaSample must be large enough to
+     * hold a complete compressed frame. For WMA Pro the frame size is the
+     * nBlockAlign field from the stream's WAVEFORMATEX (e.g. 20434 bytes for
+     * 440 kbps 44.1 kHz stereo). The default buffer_size of 16384 is too small
+     * for high-bitrate WMA Pro streams, and send_buffer() — which no longer
+     * splits compressed frames (see the output_compressed guard above) — would
+     * overflow the IMediaSample.
+     *
+     * Use the block_align from the pin's current_format (the wg_format tracked
+     * by the GStreamer parser), which reflects the actual compressed frame
+     * size even when the pin's DirectShow media type hasn't been updated from
+     * a previous probe. */
+    if (filter->output_compressed
+            && pin->current_format.major_type == WG_MAJOR_TYPE_AUDIO_WMA
+            && pin->current_format.u.audio.block_align > buffer_size)
+        buffer_size = pin->current_format.u.audio.block_align;
+
     /* We do need to drop any buffers that might have been sent with the old
      * caps, but this will be handled in parser_init_stream(). */
 
