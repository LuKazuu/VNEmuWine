diff --git a/dlls/qasf/asfreader.c b/dlls/qasf/asfreader.c
index 0bebfa9..0b7a95d 100644
--- a/dlls/qasf/asfreader.c
+++ b/dlls/qasf/asfreader.c
@@ -534,6 +534,20 @@ static HRESULT asf_reader_init_stream(struct strmbase_filter *iface)
             break;
         }
 
+        /* If the downstream filter expects compressed audio (e.g. WMA Pro
+         * passed to a DMO Wrapper decoder), enable compressed stream reading.
+         * Otherwise the IWMReader tries to decode internally (which it can't
+         * for WMA Pro), applies a 16384-byte sample cap (meant for PCM),
+         * and fragments the compressed frames, causing the downstream decoder
+         * to reject them with "Input packet too small". */
+        if (IsEqualGUID(&stream->source.pin.mt.formattype, &FORMAT_WaveFormatEx)
+                && !IsEqualGUID(&stream->source.pin.mt.subtype, &MEDIASUBTYPE_PCM)
+                && !IsEqualGUID(&stream->source.pin.mt.subtype, &MEDIASUBTYPE_IEEE_FLOAT))
+        {
+            if (FAILED(hr = IWMReaderAdvanced_SetReadStreamSamples(reader_advanced, i + 1, TRUE)))
+                WARN("Failed to set compressed reading for stream %u, hr %#lx\n", i, hr);
+        }
+
         if (FAILED(hr = IPin_NewSegment(stream->source.pin.peer, 0, 0, 1)))
         {
             WARN("Failed to start stream %u new segment, hr %#lx\n", i, hr);
@@ -616,6 +630,12 @@ static HRESULT WINAPI asf_reader_DecideBufferSize(struct strmbase_source *iface,
         WAVEFORMATEX *format = (WAVEFORMATEX *)stream->source.pin.mt.pbFormat;
         buffer_size = format->nAvgBytesPerSec;
     }
+    else if (IsEqualGUID(&stream->source.pin.mt.formattype, &FORMAT_WaveFormatEx))
+    {
+        WAVEFORMATEX *format = (WAVEFORMATEX *)stream->source.pin.mt.pbFormat;
+        if (format->nBlockAlign > buffer_size)
+            buffer_size = format->nBlockAlign;
+    }
 
     req_props->cBuffers = max(req_props->cBuffers, 1);
     req_props->cbBuffer = max(req_props->cbBuffer, buffer_size);
