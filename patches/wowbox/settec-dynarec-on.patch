diff --git a/src/dynarec/dynarec_native_functions.c b/src/dynarec/dynarec_native_functions.c
index 0dbe370..a2305cb 100644
--- a/src/dynarec/dynarec_native_functions.c
+++ b/src/dynarec/dynarec_native_functions.c
@@ -265,6 +265,18 @@ void native_priv(x64emu_t* emu)
     EmitSignal(emu, X64_SIGSEGV, (void*)R_RIP, 0xbad0);
 }
 
+void native_int1(x64emu_t* emu)
+{
+    // 0xF1 ICEBP: use the interpreter's code (see x64run.c case 0xF1) instead of
+    // native_priv()'s 0xbad0.  emit_signal_wine.c() maps 0xbad0 to
+    // EXCEPTION_PRIV_INSTRUCTION (0xc0000096) but everything else to
+    // STATUS_ACCESS_VIOLATION; AlphaROM's DRM (Settec) only accepts the same
+    // exception the interpreter path produces, otherwise it treats the emulated
+    // context as tampered and the game never starts.
+    emu->old_ip = R_RIP;
+    EmitSignal(emu, X64_SIGSEGV, (void*)R_RIP, 128);
+}
+
 void native_gpf(x64emu_t* emu)
 {
     emu->test.test = 0;
