+/*
+ * .seh_pushframe does not restore FP.  If RtlCaptureContext is called from a
+ * regular compiler-generated C frame, unwinding a guest exception can apply
+ * an FP-based SP restoration and corrupt the parent ARM64 return frame.  FEX
+ * uses this deliberately simple frame around its WOW64 simulation entry for
+ * the same reason.  Keep the CONTEXT allocation and unwind annotations in
+ * lockstep with Wine's 0x390-byte ARM64 CONTEXT layout.
+ */
+void __attribute__((naked)) BTCpuSimulate(void)
+{
+    asm(".seh_proc BTCpuSimulate\n\t"
+        "sub sp, sp, #0x390\n\t"
+        ".seh_stackalloc 0x390\n\t"
+        "stp x29, x30, [sp, #-0x10]!\n\t"
+        ".seh_save_fplr_x 16\n\t"
+        ".seh_endprologue\n\t"
+        "add x0, sp, #0x10\n\t"
+        "bl RtlCaptureContext\n\t"
+        "add x0, sp, #0x10\n\t"
+        "bl BTCpuSimulateImpl\n\t"
+        "ldp x29, x30, [sp], #0x10\n\t"
+        "add sp, sp, #0x390\n\t"
+        "ret\n\t"
+        ".seh_endproc");
+}
