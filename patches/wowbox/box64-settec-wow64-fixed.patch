+/*
+ * Publish the interpreter state to Wine's WOW64 CPU area before raising a
+ * native exception.  The dynarec path can reconstruct guest registers from
+ * the faulting host context in BTCpuResetToConsistentState(), but an
+ * interpreter-originated RtlRaiseException() has no JIT context to decode.
+ * Without this copy Wine dispatches the guest exception using the stale
+ * state from the previous syscall / BTCpuSimulate entry.
+ */
+void WowBox64StoreContext(x64emu_t* emu)
+{
+    WOW64_CPURESERVED* cpu = NtCurrentTeb()->TlsSlots[WOW64_TLS_CPURESERVED];
+    WOW64_CONTEXT* ctx;
+
+    if (!cpu || !emu)
+        return;
+
+    ctx = (WOW64_CONTEXT*)(cpu + 1);
+    ctx->Eax = R_EAX;
+    ctx->Ebx = R_EBX;
+    ctx->Ecx = R_ECX;
+    ctx->Edx = R_EDX;
+    ctx->Esi = R_ESI;
+    ctx->Edi = R_EDI;
+    ctx->Ebp = R_EBP;
+    ctx->Esp = R_ESP;
+    ctx->Eip = R_RIP;
+    ctx->EFlags = emu->eflags.x64;
+    ctx->SegCs = R_CS;
+    ctx->SegDs = R_DS;
+    ctx->SegEs = R_ES;
+    ctx->SegFs = R_FS;
+    ctx->SegGs = R_GS;
+    ctx->SegSs = R_SS;
+    box_to_fpu(ctx, emu);
+}
