diff --git a/wine/wow64/wowbox64.c b/wine/wow64/wowbox64.c
--- a/wine/wow64/wowbox64.c
+++ b/wine/wow64/wowbox64.c
@@ -471,6 +471,17 @@
     if (!box64_is_addr_in_jit(ULongToPtr(ctx->Pc)))
         return STATUS_SUCCESS;
 
+    /* Software-raised guest traps (privileged-instruction #GP 0xc0000096,
+       illegal-instruction, divide-by-zero, breakpoint, ...) arrive here through
+       EmitSignal()/EmitInterruptionImpl(), which already published a consistent
+       guest context via WowBox64StoreContext(). Rewinding to the JIT block entry
+       here would (a) hand the guest SEH handler stale pre-instruction registers
+       -- AlphaROM's DRM treats that as tampering and hangs -- and (b) make the
+       block re-run the faulting instruction forever. Only genuine hardware
+       access violations need the host-unwind + reconstruction reset below. */
+    if (rec->ExceptionCode != EXCEPTION_ACCESS_VIOLATION)
+        return STATUS_SUCCESS;
+
     /* Replace the host context with one captured before JIT entry so host code can unwind */
     memcpy(ctx, NtCurrentTeb()->TlsSlots[WOW64_TLS_ENTRY_CONTEXT], sizeof(*ctx));
     return STATUS_SUCCESS;
