diff --git a/wine/wow64/wowbox64.c b/wine/wow64/wowbox64.c
index 4ef50314d..d99088b28 100644
--- a/wine/wow64/wowbox64.c
+++ b/wine/wow64/wowbox64.c
@@ -369,6 +369,18 @@ NTSTATUS WINAPI BTCpuProcessInit(void)
     InitializeEnvFiles();
     InitializeSystemInfo();
 
+    /* The WOW64 backend does not compile src/libtools/signals.c (it uses
+       emit_signal_wine.c instead), so self-modifying code cannot be detected
+       through the usual write-protect + SIGSEGV mechanism, and Wine's
+       BTCpuNotifyMemoryDirty() only fires for syscall-mediated writes, not for
+       dynarec-translated store instructions that touch guest code pages
+       directly.  Without this, freshly-unpacked/self-modifying code (e.g.
+       AlphaROM DRM) is never re-validated and box64 loops forever trying to
+       build a dynablock for it.  Force the "always-test/NEVERCLEAN" dirty mode
+       so such blocks are re-validated by hash on every run.  The user can
+       still override via BOX64_DYNAREC_DIRTY=0/1. */
+    SET_BOX64ENV_IF_EMPTY(dynarec_dirty, 2);
+
     if (!BOX64ENV(nobanner)) PrintBox64Version(1);
     if (DetectHostCpuFeatures())
         PrintHostCpuFeatures();
