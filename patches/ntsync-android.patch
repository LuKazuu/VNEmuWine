diff --git a/server/thread.c b/server/thread.c
index bdf48c4..a29d1e3 100644
--- a/server/thread.c
+++ b/server/thread.c
@@ -60,6 +60,10 @@
 #include "user.h"
 #include "security.h"
 
+#ifdef HAVE_LINUX_NTSYNC_H
+# include <linux/ntsync.h>   /* for NTSYNC_ANDROID_USED_BY_SERVER sentinel */
+#endif
+
 
 /* thread queues */
 
@@ -1745,8 +1749,17 @@ DECL_HANDLER(init_first_thread)
 
     if ((fd = get_inproc_device_fd()) >= 0)
     {
-        reply->inproc_device = get_process_id( process ) | 1;
-        send_client_fd( process, fd, reply->inproc_device );
+        if (fd == NTSYNC_ANDROID_USED_BY_SERVER)
+        {
+            /* Userspace ntsync (ntsync-android): no fd to send; the client
+             * initializes the shared region itself on receipt of the sentinel. */
+            reply->inproc_device = NTSYNC_ANDROID_USED_BY_SERVER;
+        }
+        else
+        {
+            reply->inproc_device = get_process_id( process ) | 1;
+            send_client_fd( process, fd, reply->inproc_device );
+        }
     }
 }
 
@@ -2383,6 +2396,14 @@ DECL_HANDLER(get_inproc_alert_fd)
     else
     {
         reply->handle = get_thread_id( current ) | 1; /* arbitrary token */
-        send_client_fd( current->process, fd, reply->handle );
+        if (get_inproc_device_fd() == NTSYNC_ANDROID_USED_BY_SERVER)
+        {
+            /* Userspace ntsync: pass the u32 alert handle in the reply,
+             * no SCM_RIGHTS fd passing (the "fd" is actually a u32
+             * ntsync-android handle, which sendmsg would reject with EBADF). */
+            reply->ntsync_handle = (unsigned int)fd;
+        }
+        else
+            send_client_fd( current->process, fd, reply->handle );
     }
 }
