# ntsync-android Wine integration patch.
# Replaces Wine's native /dev/ntsync ioctl calls with
# ntsync-android (https://github.com/joshuatam/ntsync-android)
# function calls, so that the ntsync fast-path works on
# Android where /dev/ntsync does not exist.
#
# Apply AFTER installing:
#   $PREFIX/include/ntsync_user.h       (from ntsync-android)
#   $PREFIX/include/linux/ntsync.h      (shim, see files/linux/ntsync.h)
#   $PREFIX/lib/libntsync_android.so    (from ntsync-android)
#
# Build needs: ac_cv_header_linux_ntsync_h=yes and -lntsync_android on ntdll.
# See build.sh for the full integration recipe.
#
# NOTE: After applying this patch, run `perl tools/make_requests` to
# regenerate server/request_handlers.h and include/wine/server_protocol.h
# from the modified server/protocol.def. The build system does this
# automatically when protocol.def is newer than the generated headers.

diff --git a/dlls/ntdll/unix/server.c b/dlls/ntdll/unix/server.c
index 1629ee6..b285590 100644
--- a/dlls/ntdll/unix/server.c
+++ b/dlls/ntdll/unix/server.c
@@ -78,6 +78,10 @@
 #include "wine/server.h"
 #include "wine/debug.h"
 #include "unix_private.h"
+
+#ifdef HAVE_LINUX_NTSYNC_H
+# include <linux/ntsync.h>   /* for NTSYNC_ANDROID_USED_BY_SERVER sentinel */
+#endif
 #include "ddk/wdm.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(server);
@@ -1696,8 +1700,19 @@ size_t server_init_process(void)
             supported_machines_count = wine_server_reply_size( reply ) / sizeof(*supported_machines);
             if (reply->inproc_device)
             {
-                inproc_device_fd = wine_server_receive_fd( &handle );
-                assert( handle == reply->inproc_device );
+                if (reply->inproc_device == NTSYNC_ANDROID_USED_BY_SERVER)
+                {
+                    /* Userspace ntsync (ntsync-android): the server has no
+                     * /dev/ntsync fd to send; instead it sets the sentinel
+                     * and we initialize the shared region on the client side. */
+                    inproc_device_fd = NTSYNC_ANDROID_USED_BY_SERVER;
+                    ntsync_init( NULL );
+                }
+                else
+                {
+                    inproc_device_fd = wine_server_receive_fd( &handle );
+                    assert( handle == reply->inproc_device );
+                }
             }
         }
     }
